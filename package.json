{
  "name": "sistema-inventario",
  "version": "1.0.0",
  "description": "Sistema de inventario con Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-win": "electron-builder --win"
  },
  "keywords": [
    "inventario",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0"
  },
  "build": {
    "appId": "com.inventario.app",
    "productName": "Sistema de Inventario",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "**/*",
      "!node_modules/**/*{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!node_modules/**/*.{md,ts,map}",
      "!node_modules/**/*{test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/.{bin,coverage}",
      "!node_modules/**/.{nyc_output,test}",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@supabase/**/*",
      "node_modules/@supabase"
    ],
    "extraResources": [
      {
        "from": "node_modules/@supabase",
        "to": "node_modules/@supabase",
        "filter": ["**/*"]
      }
    ]
  }
}
